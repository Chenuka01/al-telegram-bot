BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
ADMIN_IDS=123456789

# Gemini AI Tutor API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Ollama AI (optional fallback)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Render Webhook Settings ---
# After deploying on Render, your app URL looks like:
#   https://your-app-name.onrender.com
WEBHOOK_URL=https://your-app-name.onrender.com
WEBHOOK_PATH=/webhook
# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
